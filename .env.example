# Copy to .env on each computer; nonempty process environment settings win.
# Keep .env private. Never use VITE_ variables for credentials.
FX_PRIMARY_PROVIDER=yahoo
YAHOO_FX_ENABLED=true
TWELVEDATA_ENABLED=true
# Optional backup: run python scripts/configure-fx.py to validate and save a key.
TWELVEDATA_API_KEY=
# All nine BOP countries use public sources; FRED_API_KEY is optional.
BOP_ENABLED=true
# Optional: add your organisation's trusted CA bundle if HTTPS verification fails.
# Relative paths resolve from the project folder. Certificate checks stay enabled.
# BOP_CA_FILE=certificates/company-ca.pem
