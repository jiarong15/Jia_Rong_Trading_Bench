# Copy to .env on each computer; nonempty process environment settings win.
# Keep .env private. Never use VITE_ variables for credentials.
FX_PRIMARY_PROVIDER=yahoo
YAHOO_FX_ENABLED=true
TWELVEDATA_ENABLED=true
# Optional backup: run python scripts/configure-fx.py to validate and save a key.
TWELVEDATA_API_KEY=
# FX carry: public Investing.com 1Y forward points are checked every minute.
FX_INVESTING_FORWARDS_ENABLED=true
# Options IV: Saxo public OTC ATM report, checked every minute; no key required.
FX_SAXO_REPORT_ENABLED=true
# U.S. Rates dashboard: published FRED data, checked every minute while visible.
RATES_ENABLED=true
# Free DTCC USD CPI-U 5Y swap trade medians; checks every minute in background.
RATES_DTCC_ENABLED=true
# FX heatmap: public DTCC trade activity; estimated Greeks use connected forward/ATM feeds.
FX_OPTIONS_ENABLED=true
# Optional genuine U.S. CPI 5Y zero-coupon inflation swap JSON bridge (overrides DTCC).
# RATES_INFLATION_SWAP_URL=https://your-provider-bridge.example/us-inflation-swap
# RATES_INFLATION_SWAP_TOKEN=
# Optional exact forwards + ATM volatility bridge takes precedence over the website.
# FX_CARRY_FEED_URL=https://your-provider-bridge.example/fx/carry-risk
# FX_CARRY_FEED_TOKEN=
# FX_CARRY_IV_TENOR=12M
# FX_ANALYTICS_CA_FILE=certificates/company-ca.pem
# All nine BOP countries use public sources; FRED_API_KEY is optional.
BOP_ENABLED=true
# Official Treasury daily yields: FRED API when configured, public CSV fallback.
BONDS_FRED_API_KEY=
BONDS_ENABLED=true
# BONDS_CA_FILE=certificates/company-ca.pem
# Optional: add your organisation's trusted CA bundle if HTTPS verification fails.
# Relative paths resolve from the project folder. Certificate checks stay enabled.
# BOP_CA_FILE=certificates/company-ca.pem
